# Copier ce fichier en .env (ou définir les variables dans l'environnement Windows).
# JAMAIS de vraie valeur dans un chat, un commit ou un fichier versionné.

# Clé OpenRouter (réutilisée de GrantHound) — analyse IA + recherche d'actualités.
OPENROUTER_API_KEY=

# Clé Brevo (réutilisée de GrantHound) — envoi du récap quotidien par email.
BREVO_API_KEY=

# Clé Twelve Data (https://twelvedata.com, palier gratuit) — données de marché actions + forex.
TWELVEDATA_API_KEY=

# Adresse qui reçoit le récap quotidien.
TRADINGPOP_EMAIL_DESTINATAIRE=

# Adresse expéditrice utilisée par Brevo (doit être validée dans le compte Brevo).
TRADINGPOP_EMAIL_EXPEDITEUR=
